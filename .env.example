# 1) Copia este archivo:   cp .env.example .env
# 2) Pega tu key de OpenAI (https://platform.openai.com/api-keys). Nunca la subas a git.
API_KEY=PEGA_AQUI_TU_API_KEY
MODEL=gpt-4.1-mini
BASE_URL=https://api.openai.com/v1
PORT=3000

# Cualquier API compatible con OpenAI sirve. Por ejemplo:
#   OpenRouter (Llama):  BASE_URL=https://openrouter.ai/api/v1   MODEL=meta-llama/llama-3.3-70b-instruct
#   Ollama local:        BASE_URL=http://localhost:11434/v1      MODEL=llama3.2
